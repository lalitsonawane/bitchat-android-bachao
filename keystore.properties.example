# Copy to keystore.properties (gitignored) and fill in real values.
# Paths are resolved relative to the repository root.
#
#   cp keystore.properties.example keystore.properties
#
# Alternatively, export these environment variables instead of using this file:
#   BITCHAT_STORE_FILE
#   BITCHAT_STORE_PASSWORD
#   BITCHAT_KEY_ALIAS
#   BITCHAT_KEY_PASSWORD

storeFile=path/to/your-upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
